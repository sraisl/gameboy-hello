; font.rgbasm — 8x8 pixel font data (2bpp, DMG)
; This file is INCLUDED from main.rgbasm's FontData section.
; Each glyph is 16 bytes: two interleaved bitplane bytes per pixel row.
; Equal low/high bytes select DMG color 3 for every set pixel.
; Only the characters needed for "HELLO WORLD!" are defined.
; Order (index == tile index used by the message):
;   0 = space, 1 = H, 2 = E, 3 = L, 4 = O, 5 = W, 6 = R, 7 = D, 8 = '!'

; space (0)
    dw `00000000, `00000000, `00000000, `00000000
    dw `00000000, `00000000, `00000000, `00000000
; H (1)
    dw `03300330, `03300330, `03300330, `03333330
    dw `03300330, `03300330, `03300330, `00000000
; E (2)
    dw `03333330, `03300000, `03300000, `03333300
    dw `03300000, `03300000, `03333330, `00000000
; L (3)
    dw `03300000, `03300000, `03300000, `03300000
    dw `03300000, `03300000, `03333330, `00000000
; O (4)
    dw `00333300, `03300330, `03300330, `03300330
    dw `03300330, `03300330, `00333300, `00000000
; W (5)
    dw `03300330, `03300330, `03300330, `03300330
    dw `03333330, `03333330, `00300300, `00000000
; R (6)
    dw `03333000, `03300300, `03300300, `03333000
    dw `03303000, `03300300, `03300030, `00000000
; D (7)
    dw `03333000, `03300300, `03300300, `03300300
    dw `03300300, `03300300, `03333000, `00000000
; '!' (8)
    dw `00033000, `00033000, `00033000, `00033000
    dw `00033000, `00000000, `00033000, `00000000
