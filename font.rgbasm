; font.rgbasm — 8x8 pixel font data (2bpp, DMG)
; This file is INCLUDED from main.rgbasm's FontData section.
; Each glyph is 16 bytes (8 rows x 2 bits/px). Bit value 1 = dark pixel.
; Only the characters needed for "HELLO WORLD!" are defined.
; Order (index == tile index used by the message):
;   0 = space, 1 = H, 2 = E, 3 = L, 4 = O, 5 = W, 6 = R, 7 = D, 8 = '!'

; space (0)
    db $00, $00, $00, $00, $00, $00, $00, $00
    db $00, $00, $00, $00, $00, $00, $00, $00
; H (1)
    db $7C, $7C, $44, $44, $7C, $44, $44, $7C
    db $38, $38, $22, $22, $38, $22, $22, $38
; E (2)
    db $7C, $7C, $40, $40, $78, $40, $40, $7C
    db $38, $38, $20, $20, $38, $20, $20, $38
; L (3)
    db $40, $40, $40, $40, $40, $40, $40, $7C
    db $20, $20, $20, $20, $20, $20, $20, $38
; O (4)
    db $38, $38, $44, $44, $44, $44, $44, $38
    db $1C, $1C, $22, $22, $22, $22, $22, $1C
; W (5)
    db $44, $44, $54, $54, $54, $6C, $44, $44
    db $22, $22, $2A, $2A, $2A, $36, $22, $22
; R (6)
    db $78, $78, $44, $44, $78, $48, $44, $42
    db $38, $38, $22, $22, $38, $2C, $22, $21
; D (7)
    db $78, $78, $44, $44, $44, $44, $44, $78
    db $38, $38, $22, $22, $22, $22, $22, $38
; '!' (8)
    db $10, $10, $10, $10, $10, $00, $10, $00
    db $08, $08, $08, $08, $08, $00, $08, $00
