; hardware.rgbinc — minimal Game Boy hardware register definitions
; (DMG-compatible subset used by this project)

DEF rIF   EQU $FF0F
DEF rLCDC EQU $FF40
DEF rSTAT EQU $FF41
DEF rSCY  EQU $FF42
DEF rSCX  EQU $FF43
DEF rLY   EQU $FF44
DEF rLICY EQU $FF45
DEF rBGP  EQU $FF47
DEF rOBP0 EQU $FF48
DEF rOBP1 EQU $FF49
DEF rWX   EQU $FF4B
DEF rWY   EQU $FF4A
DEF rIE   EQU $FFFF
DEF rNR52 EQU $FF26

DEF LCDCF_ON    EQU %10000000
DEF LCDCF_BGON  EQU %00000001
DEF LCDCF_OBJON EQU %00000010
DEF LCDCF_OBJ16 EQU %00000100
DEF LCDCF_BG9800 EQU %00001000
DEF LCDCF_BG8000 EQU %00010000
DEF LCDCF_WINON  EQU %00100000
DEF LCDCF_WIN9800 EQU %01000000
DEF LCDCF_WIN8000 EQU %10000000
